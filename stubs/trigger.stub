<?php

namespace {{ namespace }};

use InvalidArgumentException;
use Nodeflow\Schema\TriggerDefinition;
use Nodeflow\Triggers\LaravelEvent\LaravelEventOccurrence;
use Nodeflow\Triggers\LaravelEvent\LaravelEventTriggerDriver;
use Nodeflow\Triggers\LaravelEvent\LaravelEventTriggerSource;
use Nodeflow\Triggers\TriggerMatch;
use Nodeflow\Triggers\TriggerOccurrence;

class {{ class }} implements LaravelEventTriggerSource
{
    /** Stable within the Laravel-event driver. */
    public static function key(): string
    {
        return '{{ type }}';
    }

    public static function driver(): string
    {
        return LaravelEventTriggerDriver::key();
    }

    /** The only host event class this source allows Nodeflow to observe. */
    public static function eventClass(): string
    {
        return \{{ event }}::class;
    }

    public function definition(): TriggerDefinition
    {
        return TriggerDefinition::make('{{ label }}')
            ->description('TODO: describe when this trigger fires for a flow author.');
    }

    /**
     * Extract immutable value data explicitly. Nodeflow never reflects over or
     * automatically serializes the event object.
     */
    public function snapshot(object $event): LaravelEventOccurrence
    {
        if (! $event instanceof \{{ event }}) {
            throw new InvalidArgumentException('Unexpected Laravel event class.');
        }

        return new LaravelEventOccurrence(
            eventClass: $event::class,
            data: [
                // TODO: copy only the safe values resolve() needs.
            ],
        );
    }

    /** Resolve the snapshot and per-flow config into tenant audiences. */
    public function resolve(TriggerOccurrence $occurrence, array $config): TriggerMatch
    {
        if (! $occurrence->payload instanceof LaravelEventOccurrence) {
            throw new InvalidArgumentException('Expected a Laravel event occurrence.');
        }

        // TODO: filter with $config and return subjects, sanitized trigger data,
        // and a stable occurrence identity when delivery can repeat.
        return TriggerMatch::make();
    }
}
